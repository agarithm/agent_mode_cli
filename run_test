#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path | None:
    current = start.resolve()
    for _ in range(10):
        candidate = current / "src" / "agent_mode_cli" / "__init__.py"
        if candidate.is_file():
            return current
        if current.parent == current:
            break
        current = current.parent
    return None


def _usage() -> None:
    print("usage: ./run_test <ai|am|om> [args...]", file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    if not argv or argv[0] in {"-h", "--help"}:
        _usage()
        return 0

    tool = argv.pop(0)
    if tool not in {"ai", "am", "om"}:
        _usage()
        return 2

    repo_root = _find_repo_root(Path(__file__).parent)
    if repo_root is None:
        print("error: could not locate repo root containing src/agent_mode_cli", file=sys.stderr)
        return 1

    src_dir = repo_root / "src"
    if not src_dir.is_dir():
        print(f"error: missing src directory at: {src_dir}", file=sys.stderr)
        return 1

    sys.path.insert(0, str(src_dir))

    if tool == "ai":
        from agent_mode_cli.ai.app import main as tool_main
    elif tool == "am":
        from agent_mode_cli.am.app import main as tool_main
    else:
        from agent_mode_cli.om.app import main as tool_main

    return int(tool_main(argv=argv))


if __name__ == "__main__":
    raise SystemExit(main())
