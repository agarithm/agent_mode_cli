#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path | None:
    current = start.resolve()
    for _ in range(10):
        candidate = current / "src" / "entrypoints" / "ai.py"
        if candidate.is_file():
            return current
        if current.parent == current:
            break
        current = current.parent
    return None


def _usage() -> None:
    print("usage: ./test [provider] [model] [prompt or :command]", file=sys.stderr)
    print("       ./test --ui textual", file=sys.stderr)
    print("       ./test", file=sys.stderr)
    print("", file=sys.stderr)
    print("launch the source REPL with the same optional provider/model prefix as the installed 'ai' CLI", file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    if argv and argv[0] in {"-h", "--help"}:
        _usage()
        return 0

    repo_root = _find_repo_root(Path(__file__).parent)
    if repo_root is None:
        print("error: could not locate repo root containing src/entrypoints/ai.py", file=sys.stderr)
        return 1

    src_dir = repo_root / "src"
    if not src_dir.is_dir():
        print(f"error: missing src directory at: {src_dir}", file=sys.stderr)
        return 1

    sys.path.insert(0, str(src_dir))

    import os
    os.environ.setdefault("AI_CONTAINER_DISABLE","1")

    from entrypoints.ai import main as tool_main

    return int(tool_main(argv=argv))


if __name__ == "__main__":
    raise SystemExit(main())
