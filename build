#!/usr/bin/env python3

from __future__ import annotations

import argparse
import os
from pathlib import Path


ROOT = Path(__file__).resolve().parent
SRC_ROOT = ROOT / "src"


def _module_name_for_path(path: Path) -> str:
    rel = path.relative_to(SRC_ROOT)
    parts = list(rel.parts)
    if parts[-1] == "__init__.py":
        parts = parts[:-1]
    else:
        parts[-1] = parts[-1][:-3]  # strip .py
    if not parts:
        raise ValueError(f"Could not derive module name for: {path}")
    return ".".join(parts)


def _collect_sources() -> tuple[dict[str, str], set[str]]:
    sources: dict[str, str] = {}
    packages: set[str] = set()
    for py_file in SRC_ROOT.rglob("*.py"):
        mod = _module_name_for_path(py_file)
        text = py_file.read_text(encoding="utf-8")
        sources[mod] = text
        if py_file.name == "__init__.py":
            packages.add(mod)
    return sources, packages


def _render_script(entry_module: str, sources: dict[str, str], packages: set[str]) -> str:
    # Escape with repr to keep it pure-python and robust.
    sources_literal = "{\n" + ",\n".join(
        f"  {mod!r}: {src!r}" for mod, src in sorted(sources.items())
    ) + "\n}"
    packages_literal = "{" + ", ".join(repr(p) for p in sorted(packages)) + "}"

    return f"""#!/usr/bin/env python3
# Generated by ./build; DO NOT EDIT.

from __future__ import annotations

import importlib.abc
import importlib.util
import sys


_EMBEDDED_SOURCES = {sources_literal}
_EMBEDDED_PACKAGES = {packages_literal}


class _EmbeddedLoader(importlib.abc.Loader):
    def __init__(self, fullname: str):
        self.fullname = fullname

    def create_module(self, spec):
        return None

    def exec_module(self, module):
        source = _EMBEDDED_SOURCES[self.fullname]
        module.__file__ = spec_origin = f"<embedded {{self.fullname}}>"
        if getattr(module.__spec__, "submodule_search_locations", None) is not None:
            module.__path__ = ["<embedded>"]
        code = compile(source, spec_origin, "exec")
        exec(code, module.__dict__)


class _EmbeddedFinder(importlib.abc.MetaPathFinder):
    def find_spec(self, fullname, path=None, target=None):
        if fullname not in _EMBEDDED_SOURCES:
            return None
        is_pkg = fullname in _EMBEDDED_PACKAGES
        loader = _EmbeddedLoader(fullname)
        spec = importlib.util.spec_from_loader(fullname, loader, origin=f"<embedded {{fullname}}>", is_package=is_pkg)
        if is_pkg and spec is not None:
            spec.submodule_search_locations = ["<embedded>"]
        return spec


if not any(isinstance(f, _EmbeddedFinder) for f in sys.meta_path):
    sys.meta_path.insert(0, _EmbeddedFinder())


def _run_entry() -> int:
    from {entry_module} import main as _main
    result = _main()
    if result is None:
        return 0
    return int(result)


if __name__ == "__main__":
    raise SystemExit(_run_entry())
"""


def build_one(name: str, entry_module: str, out_dir: Path) -> Path:
    sources, packages = _collect_sources()
    out_dir.mkdir(parents=True, exist_ok=True)
    out_path = out_dir / name
    out_path.write_text(_render_script(entry_module, sources, packages), encoding="utf-8")
    os.chmod(out_path, 0o755)
    return out_path


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Build single-file CLIs from src/")
    parser.add_argument("--out", default=str(ROOT / "dist"), help="Output directory (default: ./dist)")
    args = parser.parse_args(argv)

    out_dir = Path(args.out).resolve()
    built: list[Path] = []
    built.append(build_one("ai", "entrypoints.ai", out_dir))

    print("Built:")
    for path in built:
        print(f"- {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
