_EMBEDDED_PACKAGES = {'agent_mode_cli', 'agent_mode_cli.ai', 'agent_mode_cli.am', 'agent_mode_cli.cm', 'agent_mode_cli.core', 'agent_mode_cli.entrypoints', 'agent_mode_cli.om', 'agent_mode_cli.providers', 'agent_mode_cli.providers.copilot', 'agent_mode_cli.providers.ollama', 'agent_mode_cli.providers.openai'}


class _EmbeddedLoader(importlib.abc.Loader):
    def __init__(self, fullname: str):
        self.fullname = fullname

    def create_module(self, spec):
        return None

    def exec_module(self, module):
        source = _EMBEDDED_SOURCES[self.fullname]
        module.__file__ = spec_origin = f"<embedded {self.fullname}>"
        if getattr(module.__spec__, "submodule_search_locations", None) is not None:
            module.__path__ = ["<embedded>"]
        code = compile(source, spec_origin, "exec")
        exec(code, module.__dict__)


class _EmbeddedFinder(importlib.abc.MetaPathFinder):
    def find_spec(self, fullname, path=None, target=None):
        if fullname not in _EMBEDDED_SOURCES:
            return None
        is_pkg = fullname in _EMBEDDED_PACKAGES
        loader = _EmbeddedLoader(fullname)
        spec = importlib.util.spec_from_loader(fullname, loader, origin=f"<embedded {fullname}>", is_package=is_pkg)
        if is_pkg and spec is not None:
            spec.submodule_search_locations = ["<embedded>"]
        return spec


if not any(isinstance(f, _EmbeddedFinder) for f in sys.meta_path):
    sys.meta_path.insert(0, _EmbeddedFinder())


def _run_entry() -> int:
    from agent_mode_cli.entrypoints.om import main as _main
    result = _main()
    if result is None:
        return 0
    return int(result)


if __name__ == "__main__":
    raise SystemExit(_run_entry())
