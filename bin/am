#!/usr/bin/env python3

import json
import shlex
import subprocess
import sys
import os

from openai import OpenAI


client = None
context = []
DEBUG = os.getenv("AM_DEBUG", "").lower() in ("1","true","yes","on")
DEFAULT_MODEL = os.getenv("AM_MODEL", "gpt-5.1-codex")
SCRIPT_PATH = os.path.abspath(__file__)
APPROVE_ALL = False
PRE_APPROVE_DEBUG = None
INTERNAL_SYSTEM_PROMPT = (
    "You are AM, a self-aware coding agent running in a terminal. "
    "You have access to a bash tool that can execute any bash command. "
    "Trust that the user is an expert programmer and values correctness and safety. "
    "Stop and ask for help if you are confused or stuck. Don't guess. "
    "Confine yourself the current working directory and its subdirectories. "
)

tools = [{
   "type": "function", "name": "set_debug",
   "description": "Toggle AM_DEBUG on or off.",
   "parameters": {
       "type": "object",
       "properties": {
           "enabled": {
               "type": "boolean",
               "description": "Whether debugging should be enabled."
           }
       },
       "required": ["enabled"],
   }
  },
  {
   "type": "function", "name": "set_model",
   "description": "Change the AM_MODEL used for future API calls.",
   "parameters": {
       "type": "object",
       "properties": {
           "model": {
               "type": "string",
               "description": "Model identifier to use."
           }
       },
       "required": ["model"],
   }
  },
  {
   "type": "function",
   "name": "bash",
   "description": "Execute bash commands in a shell. Can run any bash command or script.",
   "parameters": {
       "type": "object",
       "properties": {
           "command": {
               "type": "string",
               "description": "The bash command to execute"
           }
       },
       "required": ["command"],
   }
}]

def set_debug_command(enabled):
    global DEBUG
    DEBUG = bool(enabled)
    os.environ["AM_DEBUG"] = "1" if DEBUG else "0"
    state = "enabled" if DEBUG else "disabled"
    return f"AM_DEBUG {state}."


def set_model_command(model):
    global DEFAULT_MODEL
    if not model:
        return "error: model is required"
    DEFAULT_MODEL = model
    os.environ["AM_MODEL"] = model
    return f"AM_MODEL set to {model}."

def bash_command(command=""):
    if not command:
        return "error: command is required"
    try:
        result = subprocess.run(
            ["bash", "-c", command],
            text=True,
            capture_output=True,
            timeout=30
        )
        output = result.stdout
        if result.stderr:
            output += "\n" + result.stderr
        return output.strip() if output.strip() else "(no output)"
    except subprocess.TimeoutExpired:
        return "error: command timed out after 30 seconds"
    except Exception as exc:
        return f"error: {exc}"



TOOL_FUNCTIONS = {
    "set_debug": set_debug_command,
    "set_model": set_model_command,
    "bash": bash_command,
}

COMMAND_BUILDERS = {
    "set_debug": None,
    "set_model": None,
    "bash": None,
}

MODIFYING_TOOLS = {"bash"}


def format_command_preview(tool_name, arguments):
    builder = COMMAND_BUILDERS.get(tool_name)
    if not builder:
        return None
    try:
        command, error = builder(**arguments)
    except TypeError:
        return None
    if error or not command:
        return None
    try:
        return shlex.join(command)
    except Exception:
        return " ".join(command)

def requires_confirmation(tool_name, arguments):
    return tool_name in MODIFYING_TOOLS

def prompt_for_confirmation(tool_name, arguments):
    if APPROVE_ALL:
        if DEBUG:
            print(f"[debug] auto-approved '{tool_name}' due to approve-all mode")
        return True
    print(f"[confirm] The '{tool_name}' tool may modify files or system state.")
    if arguments:
        try:
            pretty_args = json.dumps(arguments, indent=2)
        except TypeError:
            pretty_args = str(arguments)
        print(f"[confirm] Arguments:\n{pretty_args}")
    preview = format_command_preview(tool_name, arguments if isinstance(arguments, dict) else {})
    if preview:
        print(f"[confirm] Command: {preview}")
    while True:
        try:
            answer = input("Proceed? [y/N/a]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            if DEBUG:
                print("[debug] confirmation prompt interrupted; defaulting to no")
            return False
        if answer in ("y", "yes"):
            return True
        if answer in ("a", "all"):
            enable_approve_all_mode()
            return True
        if answer in ("", "n", "no"):
            return False
        print("Please respond with 'y' or 'n'.")

def append_context(item):
    if isinstance(item, dict):
        if not item:
            if DEBUG:
                print("[debug] skipped appending empty dict to context")
            return
        content = item.get("content")
        extra_keys = set(item.keys()) - {"role", "content"}
        if isinstance(content, str) and not content.strip() and not extra_keys:
            if DEBUG:
                print("[debug] skipped appending empty content message")
            return
    context.append(item)

def extend_context(items):
    for entry in items:
        append_context(entry)


def enable_approve_all_mode():
    global APPROVE_ALL, PRE_APPROVE_DEBUG, DEBUG
    if APPROVE_ALL:
        return
    APPROVE_ALL = True
    PRE_APPROVE_DEBUG = DEBUG
    if not DEBUG:
        DEBUG = True
        os.environ["AM_DEBUG"] = "1"
    print("[confirm] All subsequent confirmations auto-approved for this user prompt.")


def reset_approve_all_mode():
    global APPROVE_ALL, PRE_APPROVE_DEBUG, DEBUG
    if not APPROVE_ALL:
        PRE_APPROVE_DEBUG = None
        return
    if PRE_APPROVE_DEBUG is not None and DEBUG != PRE_APPROVE_DEBUG:
        DEBUG = PRE_APPROVE_DEBUG
        os.environ["AM_DEBUG"] = "1" if DEBUG else "0"
    APPROVE_ALL = False
    PRE_APPROVE_DEBUG = None


def load_user_prompt():
    prompt_file = os.getenv("AM_PROMPT_FILE") or os.path.join(os.path.expanduser("~"), ".am_prompt")
    if not prompt_file:
        return None
    try:
        if os.path.isfile(prompt_file):
            with open(prompt_file, "r", encoding="utf-8") as handle:
                content = handle.read().strip()
                return content if content else None
    except Exception as exc:
        if DEBUG:
            print(f"[debug] failed to read prompt file {prompt_file}: {exc}")
    return None

def call(tools):        # now takes an arg
    if DEBUG:
        print(f"[debug] calling model with context of {len(context)} messages")
        for msg in context:
            if isinstance(msg, dict):
                role = msg.get("role") or msg.get("type", "?")
                if "content" in msg:
                    content = msg["content"]
                elif "output" in msg:
                    content = msg["output"]
                else:
                    content = ""
                preview = content if isinstance(content, str) else json.dumps(content)
            else:
                role = type(msg).__name__
                preview = str(msg)
            preview = preview if len(preview) <= 60 else preview[:60] + "..."
            print(f"[debug]   {role}: {preview}")
    return client.responses.create(model=DEFAULT_MODEL, tools=tools, input=context)

def stringify_reasoning(item):
    """Convert a reasoning output chunk into plain text for the chat log."""
    pieces = []
    for chunk in getattr(item, "content", []) or []:
        text = getattr(chunk, "text", None)
        if text:
            pieces.append(text)
    fallback = getattr(item, "text", None)
    if fallback:
        pieces.append(fallback)
    return "\n".join(pieces).strip()

def tool_call(item, args=None):    # just handles one tool
    handler = TOOL_FUNCTIONS.get(item.name)
    output_text = None
    if args is None:
        try:
            args = json.loads(item.arguments or "{}")
        except json.JSONDecodeError as exc:
            args = {}
            handler = None
            output_text = f"error: could not parse arguments ({exc})"
    if handler is None:
        if output_text is None:
            output_text = f"error: unknown tool '{item.name}'"
    else:
        try:
            result = handler(**args)
        except TypeError as exc:
            result = f"error: invalid arguments - {exc}"
        except Exception as exc:
            result = f"error: {exc}"
        output_text = (result or "").strip() or "(no output)"
    return [
        item,
        {
            "type": "function_call_output",
            "call_id": item.call_id,
            "output": output_text
        }
    ]

def handle_tools(tools, response):
    has_function_call = any(item.type == "function_call" for item in response.output)
    if response.output and response.output[0].type == "reasoning":
        reasoning_item = response.output[0]
        if has_function_call:
            append_context(reasoning_item)
            if DEBUG:
                print("[debug] reasoning event stored for tool call")
        else:
            reasoning_text = stringify_reasoning(reasoning_item)
            if reasoning_text:
                append_context({"role": "assistant", "content": f"[reasoning]\n{reasoning_text}"})
                if DEBUG:
                    print(f"[debug] reasoning detail captured as text - {reasoning_text}")
    osz = len(context)
    cancelled = False
    cancel_message = ""
    for item in response.output:
        if item.type != "function_call":
            continue
        if DEBUG:
            print(f"[debug] executing tool: {item.name}")
        try:
            args = json.loads(item.arguments or "{}") if item.arguments else {}
            if not isinstance(args, dict):
                raise ValueError("tool arguments must be an object")
        except (json.JSONDecodeError, ValueError) as exc:
            if DEBUG:
                print(f"[debug] failed to parse arguments for {item.name}: {exc}")
            extend_context([
                item,
                {
                    "type": "function_call_output",
                    "call_id": item.call_id,
                    "output": f"error: unable to parse arguments ({exc})"
                }
            ])
            continue
        if requires_confirmation(item.name, args):
            if not prompt_for_confirmation(item.name, args):
                cancel_message = f"Tool '{item.name}' execution cancelled by user."
                extend_context([
                    item,
                    {
                        "type": "function_call_output",
                        "call_id": item.call_id,
                        "output": "cancelled by user"
                    }
                ])
                append_context({"role": "assistant", "content": cancel_message})
                cancelled = True
                break
        extend_context(tool_call(item, args=args))
    if DEBUG:
        print("[debug] tool handling complete")
    return len(context) != osz, cancelled, cancel_message

def process(line):
    if DEBUG:
        print(f"[debug] processing line: {line}")
    append_context({"role": "user", "content": line})
    response = call(tools)
    # new code: resolve tool calls
    printed_progress = False
    while True:
        if not DEBUG:
            print(".", end="", flush=True)
            printed_progress = True
        has_more, cancelled, cancel_message = handle_tools(tools, response)
        if cancelled:
            if printed_progress:
                print()
            if DEBUG:
                print("[debug] tool execution cancelled by user; returning to prompt")
            return cancel_message or "Tool execution cancelled by user."
        if not has_more:
            break
        if DEBUG:
            print("[debug] tool called, fetching follow-up response")
        response = call(tools)
    if printed_progress:
        print()
    if DEBUG:
        print("[debug] completed response cycle")
    if getattr(response, "output_text", None):
        append_context({"role": "assistant", "content": response.output_text})
    return response.output_text

def main(initial_line=None):
    try:
        append_context({"role": "system", "content": INTERNAL_SYSTEM_PROMPT})
        user_prompt = load_user_prompt()
        if user_prompt:
            append_context({"role": "system", "content": user_prompt})
        if initial_line is not None:
            stripped = initial_line.strip()
            if stripped:
                try:
                    result = process(stripped)
                finally:
                    reset_approve_all_mode()
                print(f">>> {result}\n")
        while True:
            line = input("> ")
            if not line.strip():
                continue
            if line.strip().lower() in ("exit", "quit", "q"):
                print("Exiting.")
                break
            try:
                result = process(line)
            finally:
                reset_approve_all_mode()
            print(f">>> {result}\n")
    except EOFError:           # Ctrl‑D
        print("\nInterrupted – exiting.")
        sys.exit(0)
    except KeyboardInterrupt:        # Ctrl‑C
        print("\nInterrupted – exiting.")
        sys.exit(0)


if __name__ == "__main__":
    import sys
    import json
    import subprocess
    from openai import OpenAI

    client = OpenAI()
    initial_line = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else None
    main(initial_line)
